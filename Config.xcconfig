// Defaults that allow a clean checkout to build without a signing identity.
CODE_SIGN_IDENTITY = -
CODE_SIGN_STYLE = Manual
DEVELOPMENT_TEAM =
PROVISIONING_PROFILE_SPECIFIER =

// Leave empty for source builds. Set this in Local.xcconfig for a distributed
// build that uses Sparkle updates.
TENUO_FEED_URL =

#include? "Local.xcconfig"
