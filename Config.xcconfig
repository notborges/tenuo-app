// A clean checkout builds without a signing identity. Copy
// Local.xcconfig.example to Local.xcconfig for a stable local signature.
// Local.xcconfig is ignored, so personal signing details stay off GitHub.

// Ad-hoc signing works everywhere, but its code hash changes after a rebuild.
// macOS will therefore ask for Accessibility access again. A real signing
// identity in Local.xcconfig makes that permission persist.
CODE_SIGN_IDENTITY = -
CODE_SIGN_STYLE = Manual
DEVELOPMENT_TEAM =
PROVISIONING_PROFILE_SPECIFIER =

// Leave these empty for source builds. The release script supplies the
// official update channel values for distributed builds.
TENUO_FEED_URL =
TENUO_SPARKLE_PUBLIC_KEY =

#include? "Local.xcconfig"
