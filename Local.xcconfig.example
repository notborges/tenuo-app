// Copy this file to Local.xcconfig and replace the values below.
// Local.xcconfig is gitignored and must not be committed.
//
// Find installed identities with:
//   security find-identity -v -p codesigning
//
// Use Apple Development for normal Xcode runs. The release script selects a
// Developer ID Application identity when it archives the app.
CODE_SIGN_IDENTITY = Apple Development
DEVELOPMENT_TEAM = TEAMID

// Enable after associating both app IDs with your CloudKit container.
// CODE_SIGN_STYLE = Automatic
// TENUO_CODE_SIGN_ENTITLEMENTS = Tenuo/Resources/TenuoCloud.entitlements

TENUO_POLAR_ORGANIZATION_ID =
TENUO_POLAR_BENEFIT_ID =
